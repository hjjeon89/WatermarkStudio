<Window x:Class="WatermarkStudio.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="사용 방법 — Watermark Studio" Icon="/WatermarkStudio;component/Assets/app.ico"
    Width="740" Height="760" MinWidth="580" MinHeight="480"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    FontFamily="Malgun Gothic" FontSize="13" Foreground="#252B39" Background="#F5F6F8">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,22,0,8"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" Padding="28,22" BorderBrush="#E1E5EC" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="Watermark Studio 사용 방법" FontSize="23" FontWeight="Bold"/><TextBlock Text="사진을 고르고, 워터마크를 꾸민 다음, 새 파일로 저장하세요." Foreground="#737D90" Margin="0,8,0,0"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,24">
            <StackPanel>
                <TextBlock Text="1. 이미지 선택" Style="{StaticResource Heading}"/>
                <TextBlock Text="‘여러 이미지 선택’을 누르거나 파일을 화면에 끌어다 놓으세요. 편집 중에는 ‘＋ 이미지 추가’로 더 넣을 수 있습니다. 아래쪽 썸네일을 누르면 해당 이미지의 미리보기가 표시됩니다. 썸네일의 ×는 목록에서만 제거합니다."/>
                <TextBlock Text="2. 텍스트 또는 로고 추가" Style="{StaticResource Heading}"/>
                <TextBlock Text="‘텍스트 추가’로 문구를, ‘로고 추가’로 이미지 워터마크를 넣으세요. 투명 배경의 PNG 로고를 권장합니다. 여러 개를 추가할 수 있고, 설정 위쪽 목록에서 편집할 워터마크를 선택할 수 있습니다. 목록 옆 ×로 선택한 워터마크를 삭제합니다."/>
                <TextBlock Text="3. 미리보기에서 마우스로 조정" Style="{StaticResource Heading}"/>
                <Border Background="#EAF0FF" CornerRadius="8" Padding="16,12">
                    <TextBlock><Run FontWeight="Bold" Text="이동"/><Run Text="  워터마크 안쪽을 드래그하세요.&#x0a;"/><Run FontWeight="Bold" Text="크기"/><Run Text="  선택 테두리의 네 모서리 사각형을 드래그하세요.&#x0a;"/><Run FontWeight="Bold" Text="회전"/><Run Text="  테두리 위쪽의 원을 드래그하세요.&#x0a;"/><Run FontWeight="Bold" Text="15° 단위 회전"/><Run Text="  Shift를 누른 채 회전하세요.&#x0a;"/><Run FontWeight="Bold" Text="드래그 취소"/><Run Text="  마우스를 놓기 전에 Esc를 누르세요."/></TextBlock>
                </Border>
                <TextBlock Text="4. 텍스트를 그 자리에서 편집" Style="{StaticResource Heading}"/>
                <TextBlock Text="미리보기의 텍스트를 더블클릭하세요. 텍스트를 클릭해 선택한 뒤 F2를 눌러도 됩니다. 오른쪽 텍스트 입력란에서도 수정할 수 있습니다."/>
                <TextBlock Margin="0,8,0,0"><Run FontWeight="Bold" Text="Enter"/><Run Text="  편집 완료&#x0a;"/><Run FontWeight="Bold" Text="Shift + Enter"/><Run Text="  줄바꿈&#x0a;"/><Run FontWeight="Bold" Text="Esc"/><Run Text="  이번 직접 편집을 취소하고 이전 내용으로 복원&#x0a;"/><Run Text="다른 곳을 클릭하면 편집한 내용이 적용됩니다."/></TextBlock>
                <TextBlock Text="5. 스타일과 배치 설정" Style="{StaticResource Heading}"/>
                <TextBlock Text="오른쪽 패널에서 글꼴, 굵게·기울임·밑줄, 크기, 색상, 그림자, 배경, 불투명도와 회전을 조정하세요. 색상은 #FFFFFF 형식으로 입력합니다. 글꼴 크기는 이미지 너비 1,000px 기준이며 이미지마다 같은 비율로 적용됩니다. 로고는 가로세로 비율을 유지합니다."/>
                <TextBlock Text="9방향 위치 버튼으로 빠르게 정렬하거나 ‘반복 배치 (모자이크)’를 켜 화면 전체에 배치할 수 있습니다. ‘원본 보기’를 켜면 워터마크가 없는 원본을 확인합니다. 편집을 계속하려면 원본 보기를 끄세요." Margin="0,8,0,0"/>
                <TextBlock Text="6. 모든 이미지에 적용하고 저장" Style="{StaticResource Heading}"/>
                <TextBlock Text="저장 형식을 고르고 ‘워터마크 적용 후 저장’을 누른 뒤 저장 폴더를 선택하세요. 현재 워터마크 설정을 목록의 모든 이미지에 적용합니다. 파일은 원래 픽셀 크기로 저장되며 이름 뒤에 _watermarked가 붙습니다. 같은 이름이 있으면 번호를 붙여 기존 파일을 보존합니다."/>
                <TextBlock Text="‘작업 중지’를 누르면 현재 파일을 마친 뒤 중지하며 이미 저장한 파일은 유지됩니다. 일부 파일이 실패하면 나머지는 계속 처리하고 완료 후 결과를 알려줍니다." Margin="0,8,0,0"/>
                <TextBlock Text="지원 형식과 참고 사항" Style="{StaticResource Heading}"/>
                <TextBlock Text="• JPG, PNG, 정적 GIF를 지원합니다. 움직이는 GIF는 지원하지 않습니다.&#x0a;• PNG는 투명도를 유지하며 JPG로 저장할 때는 투명한 부분이 흰색이 됩니다. GIF는 색상 수가 제한됩니다.&#x0a;• 이미지는 6,000만 픽셀 이하, 한 변 32,767px 이하로 선택하세요.&#x0a;• 모든 이미지는 내 PC에서 처리하고 원본을 덮어쓰지 않습니다.&#x0a;• 저장 결과에 EXIF 등 원본 메타데이터는 포함되지 않습니다.&#x0a;• 편집 설정은 앱을 닫으면 초기화됩니다. 종료 전에 결과를 저장하세요." Foreground="#60697C"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel><Button Content="닫기" IsCancel="True" IsDefault="True" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="24,8"/><TextBlock Text="상단 ‘사용 방법’ 또는 F1으로 다시 볼 수 있습니다." Foreground="#737D90" VerticalAlignment="Center" FontSize="12"/></DockPanel>
        </Border>
    </Grid>
</Window>
